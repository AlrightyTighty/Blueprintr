# Copy to .env for local development (`npm run dev` loads it). Never commit real values.

# Postgres. Apply the schema first: DATABASE_URL=... ../database/migrate.sh
DATABASE_URL=postgres://postgres:dev@localhost:5432/blueprint
# Local Postgres usually has no TLS. For RDS, point DATABASE_CA_PATH at the RDS CA bundle instead (see ../database/README.md).
DATABASE_SSL=disable
# DATABASE_CA_PATH=../database/certs/global-bundle.pem

# Signing key for access tokens (32+ characters) and the key that encrypts stored GitHub tokens (32 random bytes, base64).
#   openssl rand -base64 48        -> JWT_SECRET
#   openssl rand -base64 32        -> TOKEN_ENCRYPTION_KEY
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Where the frontend runs (used in email links and CORS).
FRONTEND_URL=http://localhost:5173
# CORS_ORIGIN=http://localhost:5173

# GitHub OAuth app (callback URL = GITHUB_REDIRECT_URI, a route in the frontend that posts code+state to /auth/github/callback).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/auth/github/callback
# Optional: lets people paste a link to any PUBLIC repository without connecting GitHub. Works without
# it, but GitHub then allows only 60 requests an hour per server address (about 20 analyses). Create a
# token with NO scopes (or a fine-grained token limited to public repositories) and put it here. It is
# only ever used for repositories GitHub reports as public.
# GITHUB_API_TOKEN=

# Optional integrations. Without them the matching features answer 503 integration_not_configured
# (plan explanations fall back to a rule-based text without Gemini).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_AGENT_ID=
# S3 bucket for cached briefing audio (needs AWS credentials locally; the deployed stack creates its own).
# AUDIO_BUCKET=

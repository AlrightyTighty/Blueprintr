  "findings": [
    {
      "kind": "permission_gap",
      "severity": "high",
      "title": "cancelOrder calls dynamodb:DeleteItem on orders, but aws_iam_role.api_role doesn't allow it",
      "detail": "src/api/app.js:23 calls dynamodb:DeleteItem on aws_dynamodb_table.orders. The Lambda aws_lambda_function.api runs as aws_iam_role.api_role, whose policies don't grant that action on this resource, so the call fails with AccessDenied at runtime.",
      "nodeId": "7ead2231-4494-4205-9f09-0398430f5cc8",
      "relatedNodeId": "80513c24-00ab-4308-a756-b10fc02d7d88",
      "evidence": {
        "action": "dynamodb:DeleteItem",
        "resource": "aws_dynamodb_table.orders",
        "role": "aws_iam_role.api_role",
        "location": "src/api/app.js:23",
        "inferred": false
      },
      "fingerprint": "demo-finding-0",
      "id": "demo-finding-0",
      "runId": "demo-run"
    },
    {
      "kind": "over_broad_iam",
      "severity": "high",
      "title": "aws_iam_role.api_role allows s3:* on everything, but the code uses only s3:PutObject on aws_s3_bucket.uploads, legacy-reports",
      "detail": "aws_iam_role_policy.api_access (statement 2) grants s3:* on all resources (*). The code that runs as this role uses s3:PutObject on aws_s3_bucket.uploads, legacy-reports. Narrowing the policy to what is used limits the damage if the function is compromised.",
      "nodeId": "80513c24-00ab-4308-a756-b10fc02d7d88",
      "relatedNodeId": null,
      "evidence": {
        "policy": "aws_iam_role_policy.api_access",
        "statement": 2,
        "grants": [
          "s3:*"
        ],
        "usedActions": [
          "s3:PutObject"
        ],
        "usedResources": [
          "aws_s3_bucket.uploads",
          "legacy-reports"
        ]
      },
      "fingerprint": "demo-finding-1",
      "id": "demo-finding-1",
      "runId": "demo-run"
    },
    {
      "kind": "unmanaged_resource",
      "severity": "medium",
      "title": "\"legacy-reports\" (s3) is hardcoded in code but not managed by Terraform",
      "detail": "src/api/app.js:28 (s3:PutObject). No Terraform resource of this type has that name, so changes to it can't be reviewed or reproduced and it may have drifted.",

  "sourceFiles": {
    "infra/main.tf": "resource \"aws_dynamodb_table\" \"orders\" {\r\n  name         = \"orders-${var.env}\"\r\n  billing_mode = \"PAY_PER_REQUEST\"\r\n  hash_key     = \"id\"\r\n\r\n  attribute {\r\n    name = \"id\"\r\n    type = \"S\"\r\n  }\r\n}\r\n\r\nresource \"aws_s3_bucket\" \"uploads\" {\r\n  bucket = \"ripplemap-uploads-${var.env}\"\r\n}\r\n\r\nresource \"aws_s3_bucket\" \"site\" {\r\n  bucket = \"ripplemap-site-${var.env}\"\r\n}\r\n\r\nresource \"aws_sqs_queue\" \"jobs\" {\r\n  name = \"jobs-${var.env}\"\r\n}\r\n\r\nresource \"aws_iam_role\" \"api_role\" {\r\n  name = \"api-role\"\r\n  assume_role_policy = jsonencode({\r\n    Version = \"2012-10-17\"\r\n    Statement = [{\r\n      Effect    = \"Allow\"\r\n      Action    = \"sts:AssumeRole\"\r\n      Principal = { Service = \"lambda.amazonaws.com\" }\r\n    }]\r\n  })\r\n}\r\n\r\n# Planted trap: s3:* on everything, while the code only writes one bucket.\r\nresource \"aws_iam_role_policy\" \"api_access\" {\r\n  name = \"api-access\"\r\n  role = aws_iam_role.api_role.id\r\n  # Planted trap: the code also calls dynamodb:DeleteItem, which is not allowed here.\r\n  policy = jsonencode({\r\n    Version = \"2012-10-17\"\r\n    Statement = [\r\n      {\r\n        Effect   = \"Allow\"\r\n        Action   = [\"dynamodb:GetItem\", \"dynamodb:PutItem\", \"dynamodb:Query\"]\r\n        Resource = [aws_dynamodb_table.orders.arn, \"${aws_dynamodb_table.orders.arn}/index/*\"]\r\n      },\r\n      {\r\n        Effect   = \"Allow\"\r\n        Action   = \"s3:*\"\r\n        Resource = \"*\"\r\n      },\r\n      {\r\n        Effect   = \"Allow\"\r\n        Action   = [\"sqs:SendMessage\"]\r\n        Resource = aws_sqs_queue.jobs.arn\r\n      }\r\n    ]\r\n  })\r\n}\r\n\r\nresource \"aws_iam_role\" \"worker_role\" {\r\n  name = \"worker-role\"\r\n  assume_role_policy = jsonencode({\r\n    Version = \"2012-10-17\"\r\n    Statement = [{\r\n      Effect    = \"Allow\"\r\n      Action    = \"sts:AssumeRole\"\r\n      Principal = { Service = \"lambda.amazonaws.com\" }\r\n    }]\r\n  })\r\n}\r\n\r\ndata \"aws_iam_policy_document\" \"worker\" {\r\n  statement {\r\n    actions   = [\"sqs:ReceiveMessage\", \"sqs:DeleteMessage\"]\r\n    resources = [aws_sqs_queue.jobs.arn]\r\n  }\r\n  statement {\r\n    actions   = [\"dynamodb:PutItem\", \"dynamodb:UpdateItem\"]\r\n    resources = [aws_dynamodb_table.orders.arn]\r\n  }\r\n}\r\n\r\nresource \"aws_iam_policy\" \"worker\" {\r\n  name   = \"worker\"\r\n  policy = data.aws_iam_policy_document.worker.json\r\n}\r\n\r\nresource \"aws_iam_role_policy_attachment\" \"worker\" {\r\n  role       = aws_iam_role.worker_role.name\r\n  policy_arn = aws_iam_policy.worker.arn\r\n}\r\n\r\ndata \"archive_file\" \"api\" {\r\n  type        = \"zip\"\r\n  source_dir  = \"${path.module}/../src/api\"\r\n  output_path = \"${path.module}/api.zip\"\r\n}\r\n\r\nresource \"aws_lambda_function\" \"api\" {\r\n  function_name = \"api-${var.env}\"\r\n  role          = aws_iam_role.api_role.arn\r\n  runtime       = \"nodejs20.x\"\r\n  handler       = \"app.handler\"\r\n  filename      = data.archive_file.api.output_path\r\n\r\n  environment {\r\n    variables = {\r\n      TABLE_NAME = aws_dynamodb_table.orders.name\r\n      BUCKET     = aws_s3_bucket.uploads.bucket\r\n      QUEUE_URL  = aws_sqs_queue.jobs.url\r\n    }\r\n  }\r\n}\r\n\r\ndata \"archive_file\" \"worker\" {\r\n  type        = \"zip\"\r\n  source_dir  = \"${path.module}/../src/worker\"\r\n  output_path = \"${path.module}/worker.zip\"\r\n}\r\n\r\nresource \"aws_lambda_function\" \"worker\" {\r\n  function_name = \"worker-${var.env}\"\r\n  role          = aws_iam_role.worker_role.arn\r\n  runtime       = \"python3.12\"\r\n  handler       = \"main.handler\"\r\n  filename      = data.archive_file.worker.output_path\r\n\r\n  environment {\r\n    variables = {\r\n      TABLE_NAME = aws_dynamodb_table.orders.name\r\n      QUEUE_URL  = aws_sqs_queue.jobs.url\r\n    }\r\n  }\r\n}\r\n\r\nresource \"aws_lambda_event_source_mapping\" \"jobs\" {\r\n  event_source_arn = aws_sqs_queue.jobs.arn\r\n  function_name    = aws_lambda_function.worker.arn\r\n}\r\n\r\nresource \"aws_apigatewayv2_api\" \"http\" {\r\n  name          = \"ripplemap-http\"\r\n  protocol_type = \"HTTP\"\r\n}\r\n\r\nresource \"aws_apigatewayv2_integration\" \"api\" {\r\n  api_id           = aws_apigatewayv2_api.http.id\r\n  integration_type = \"AWS_PROXY\"\r\n  integration_uri  = aws_lambda_function.api.invoke_arn\r\n}\r\n\r\nresource \"aws_cloudfront_distribution\" \"site\" {\r\n  enabled = true\r\n  aliases = [var.domain]\r\n\r\n  origin {\r\n    domain_name = aws_s3_bucket.site.bucket_regional_domain_name\r\n    origin_id   = \"site\"\r\n  }\r\n}\r\n\r\nresource \"aws_route53_record\" \"site\" {\r\n  zone_id = \"Z123\"\r\n  name    = var.domain\r\n  type    = \"A\"\r\n\r\n  alias {\r\n    name                   = aws_cloudfront_distribution.site.domain_name\r\n    zone_id                = aws_cloudfront_distribution.site.hosted_zone_id\r\n    evaluate_target_health = false\r\n  }\r\n}\r\n",
    "infra/variables.tf": "variable \"env\" {\r\n  type    = string\r\n  default = \"prod\"\r\n}\r\n\r\nvariable \"domain\" {\r\n  type    = string\r\n  default = \"demo.ripplemap.wiki\"\r\n}\r\n",
    "src/api/app.js": "const { DynamoDBClient } = require('@aws-sdk/client-dynamodb');\r\nconst { DynamoDBDocumentClient, GetCommand, PutCommand, DeleteCommand } = require('@aws-sdk/lib-dynamodb');\r\nconst { S3Client, PutObjectCommand } = require('@aws-sdk/client-s3');\r\nconst { SQSClient, SendMessageCommand } = require('@aws-sdk/client-sqs');\r\n\r\nconst db = DynamoDBDocumentClient.from(new DynamoDBClient({}));\r\nconst s3 = new S3Client({});\r\nconst sqs = new SQSClient({});\r\nconst TABLE = process.env.TABLE_NAME;\r\n\r\nasync function getOrder(id) {\r\n  const out = await db.send(new GetCommand({ TableName: TABLE, Key: { id } }));\r\n  return out.Item;\r\n}\r\n\r\nasync function saveOrder(order) {\r\n  await db.send(new PutCommand({ TableName: process.env.TABLE_NAME, Item: order }));\r\n  await sqs.send(new SendMessageCommand({ QueueUrl: process.env.QUEUE_URL, MessageBody: JSON.stringify(order) }));\r\n}\r\n\r\n// Planted trap: deleting needs dynamodb:DeleteItem, which the role does not grant.\r\nasync function cancelOrder(id) {\r\n  await db.send(new DeleteCommand({ TableName: TABLE, Key: { id } }));\r\n}\r\n\r\nasync function archiveReport(body) {\r\n  // Planted trap: this bucket is hardcoded and not in Terraform.\r\n  await s3.send(new PutObjectCommand({ Bucket: 'legacy-reports', Key: 'daily.csv', Body: body }));\r\n}\r\n\r\nasync function storeUpload(key, body) {\r\n  await s3.send(new PutObjectCommand({ Bucket: process.env.BUCKET, Key: key, Body: body }));\r\n}\r\n\r\nexports.handler = async (event) => {\r\n  if (event.requestContext.http.method === 'DELETE') return cancelOrder(event.pathParameters.id);\r\n  return getOrder(event.pathParameters.id);\r\n};\r\n\r\nmodule.exports = { saveOrder, archiveReport, storeUpload };\r\n",
    "src/worker/main.py": "import json\r\nimport os\r\n\r\nimport boto3\r\n\r\ndynamodb = boto3.resource(\"dynamodb\")\r\nsqs = boto3.client(\"sqs\")\r\ntable = dynamodb.Table(os.environ[\"TABLE_NAME\"])\r\n\r\n\r\ndef process(record):\r\n    order = json.loads(record[\"body\"])\r\n    table.put_item(Item=order)\r\n\r\n\r\ndef handler(event, context):\r\n    for record in event[\"Records\"]:\r\n        process(record)\r\n    sqs.receive_message(QueueUrl=os.environ[\"QUEUE_URL\"], MaxNumberOfMessages=1)\r\n"
  }
}
